# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Bot user of server-infra's shared MongoDB, scoped to the irregular_verbs
# database (server-infra: scripts/remote-provision-user.sh irregular_verbs).
# The bot connects with mongodb://USER:PASS@mongo:27017/?authSource=irregular_verbs.
# The password is embedded in that URI, so keep it URL-safe — letters and
# digits only (avoid @ : / ? # % and spaces), or it will break the connection.
MONGO_USERNAME=
MONGO_PASSWORD=
